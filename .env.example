# Copy to .env and replace every CHANGE_ME value.
# Never commit .env, passwords, private keys, or generated credential files.

MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_TOPIC=plant/reactor/telemetry
MQTT_EDGE_USERNAME=edge_publisher
MQTT_EDGE_PASSWORD=CHANGE_ME
MQTT_GATEWAY_USERNAME=gateway_subscriber
MQTT_GATEWAY_PASSWORD=CHANGE_ME
MQTT_CA_CERT=/app/certs/ca.crt

INFLUX_USERNAME=admin
INFLUX_PASSWORD=CHANGE_ME
INFLUX_ORG=my-org
INFLUX_BUCKET=iiot_data
INFLUX_TOKEN=CHANGE_ME
INFLUX_WRITE_MAX_RETRIES=3
INFLUX_WRITE_RETRY_DELAY_SECONDS=0.5

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

ML_BUFFER_SIZE=200
ML_RETRAIN_INTERVAL_SECONDS=300
WARMUP_TEMPERATURE_THRESHOLD_K=325.0
ML_CONTAMINATION=0.05
ML_N_ESTIMATORS=200

SENSOR_ID=CSTR_01
PUBLISH_INTERVAL=1.0
